# ─── Hybrid Fast / Free Architecture ───
# Heavy local models are off by default. Set the providers you have *free-tier*
# credentials for. Any provider left blank resolves to `mock`.
#
# API keys are read directly from env by each provider — they are NEVER logged
# or echoed back.

# ─── Vision / scene understanding ───
# Fallback chain: gemini -> openai -> pixel -> mock
VISION_PROVIDER=gemini      
VISION_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=AIzaSy...

# OpenAI Fallback
# OPENAI_API_KEY=sk-proj-...
# OPENAI_VISION_MODEL=gpt-4o-mini

# ─── ASR (Bengali transcription) ───
ASR_PROVIDER=groq           # groq | gemini | faster_whisper | mock
ASR_MODEL=whisper-large-v3-turbo
ASR_FALLBACK_PROVIDER=faster_whisper
ALLOW_LOCAL_ASR=true       # set true to permit faster-whisper as a last resort
# GROQ_API_KEY=gsk_...

# ─── Local-only fallbacks / options ───
HF_MODEL_VLM=               # opt-in HF VLM model (Florence-2 / Moondream2 / SmolVLM)
HF_TOKEN=                   # only for gated HF model downloads
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MAX_KEYFRAMES=12

# ─── Local faster-whisper knobs (only used when ALLOW_LOCAL_ASR=true) ───
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=bn       # bn default; use auto or another Whisper language code

# ─── Reranker (off by default — no general chat LLM) ───
USE_LLM=0
HF_MODEL_LLM=google/flan-t5-small
