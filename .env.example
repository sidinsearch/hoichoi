# Hugging Face env — leave blank to keep the 3-5 minute demo path (no VLM).
# Set to e.g. `HuggingFaceTB/SmolVLM-Instruct` to enable visual scene analysis.
HF_MODEL_VLM=

# Set to 1 to enable flan-t5-small reranker (off by default — no general chat LLM).
USE_LLM=0
HF_MODEL_LLM=google/flan-t5-small

# ASR — `tiny` for fast demo, `base`/`small` for better Bengali accuracy.
WHISPER_MODEL=tiny
WHISPER_COMPUTE_TYPE=int8

# Cap keyframes the VLM/visual pipeline sees (lower = faster).
MAX_KEYFRAMES=12

# Optional. Provide a token if using gated models.
# HF_TOKEN=
